# TAYLOR OS terminal (Ghostty; her pick 2026-11-23: "switch to the terminal with buttons"). It draws its own title bar
# with minimise, full screen and close. Copy and paste work as on Windows:
#   Ctrl+C copies when text is selected, and stops the running command when nothing is (like Windows Terminal)
#   Ctrl+V pastes; selecting text copies it; a right click pastes
#   Ctrl+Shift+C / Ctrl+Shift+V also work, as on Linux
keybind = performable:ctrl+c=copy_to_clipboard
keybind = ctrl+v=paste_from_clipboard
keybind = ctrl+shift+c=copy_to_clipboard
keybind = ctrl+shift+v=paste_from_clipboard
copy-on-select = clipboard
right-click-action = paste
# her dark and her text colour; buttons in the title bar
background = 0B0D0C
foreground = EDEFEE
window-decoration = auto
gtk-titlebar = true
window-padding-x = 8
window-padding-y = 6
