#!/usr/bin/python3
# ChatMix for her Arctis Nova Pro Wireless base station (USB 1038:12E0), the way Sonar does it on Windows:
# pressing the volume dial switches it to ChatMix, and turning it then balances GAME against CHAT.
# The dial turns the Game / Chat balance of the TaylorOS mixer: the volume of the two channels' "out" sides,
# taylor_game.out and taylor_chat.out (/etc/pipewire/pipewire.conf.d/taylor-mixer.conf). Her Game and Chat faders stay
# where she put them, and the balance line at the bottom of her Mixer window moves with the dial (it reads the same two
# volumes). (Before 2026-11-21 the dial moved the GAME and VOICE faders themselves.)
#
# The base station protocol is from Dymstro/nova-chatmix-linux (0BSD licence, reverse engineered from
# Sonar's USB traffic; tested by its author on MCU firmware 01.29.27, DSP 00.03.82). Only these messages are used:
#   send    06 49 01/00   ChatMix control on/off (the dial can then be pressed into ChatMix)
#   send    06 8D 01/00   the Sonar icon on the base station's screen on/off
#   receive 07 45 G C     the dial moved: game volume G and chat volume C, each 0..100
# Nothing else is ever written to the base station: no firmware, no settings, no equalizer, nothing that changes how it
# works with her PS5 (the PS5 is on its own USB input, and both messages are undone when this stops).
# No SteelSeries code or software is used.
#
# Started by udev when the base station is plugged in (60-taylor-chatmix.rules -> taylor-chatmix.service, a
# user service), stops when it is unplugged, and hands the dial back to plain volume when it stops.
#   taylor-chatmix --self-test   checks the dial-to-balance sums without a base station (prints PASS / FAIL)
import json
import signal
import subprocess
import sys
import time

VID, PID, INTERFACE = 0x1038, 0x12E0, 4
MSGLEN = 63
TX = 0x06
OPT_CHATMIX_ENABLE = 0x49
OPT_SONAR_ICON = 0x8D
OPT_CHATMIX = 0x45
GAME_OUT, CHAT_OUT = "taylor_game.out", "taylor_chat.out"


def log(*a):
    print("taylor-chatmix:", *a, flush=True)


def msg(*data):
    return bytes(data).ljust(MSGLEN, b"\0")


def find_path(hid):
    for d in hid.enumerate(VID, PID):
        if d.get("interface_number") == INTERFACE:
            return d["path"]
    return None


def node_ids():
    """node.name -> PipeWire id, for every node."""
    try:
        out = subprocess.run(["pw-dump"], capture_output=True, text=True, timeout=10).stdout
        objs = json.loads(out or "[]")
    except Exception:
        return {}
    ids = {}
    for o in objs:
        if o.get("type", "").endswith(":Node"):
            name = ((o.get("info") or {}).get("props") or {}).get("node.name")
            if name:
                ids[name] = o["id"]
    return ids


class Outs:
    """Sets the volume of a channel's out side by its node name (ids are looked up again when PipeWire restarts)."""
    def __init__(self):
        self.ids = {}

    def __call__(self, name, percent):
        percent = max(0, min(100, int(percent)))
        for attempt in (0, 1):
            if name not in self.ids or attempt:
                self.ids = node_ids()
            nid = self.ids.get(name)
            if nid is None:
                continue
            r = subprocess.run(["wpctl", "set-volume", str(nid), "%.2f" % (percent / 100)], capture_output=True, timeout=5)
            if r.returncode == 0:
                return True
        return False


class ChatMix:
    def __init__(self, dev, set_volume=None):
        self.dev = dev
        self.set_volume = set_volume or Outs()
        self.stop = False
        self.last = None
        self.enabled = False

    def start(self):
        self.dev.write(msg(TX, OPT_SONAR_ICON, 1))
        self.dev.write(msg(TX, OPT_CHATMIX_ENABLE, 1))
        self.enabled = True

    def handle(self, data):
        """One message from the base station. Returns (game, chat) when it was a dial move that changed something."""
        if not data or len(data) < 4 or data[1] != OPT_CHATMIX:
            return None
        game, chat = max(0, min(100, data[2])), max(0, min(100, data[3]))
        if (game, chat) == self.last:
            return None
        self.last = (game, chat)
        self.set_volume(GAME_OUT, game)
        self.set_volume(CHAT_OUT, chat)
        return game, chat

    def run(self):
        while not self.stop:
            data = self.dev.read(MSGLEN, 1000)   # times out every second so a stop is noticed
            self.handle(data)

    def close(self):
        if self.enabled:
            try:
                self.dev.write(msg(TX, OPT_CHATMIX_ENABLE, 0))
                self.dev.write(msg(TX, OPT_SONAR_ICON, 0))
            except OSError:
                pass   # already unplugged
            self.enabled = False


def self_test():
    got = []
    cm = ChatMix(None, set_volume=lambda n, p: got.append((n, p)))
    ok = True
    def check(what, cond):
        nonlocal ok
        print(("PASS " if cond else "FAIL ") + what)
        ok = ok and cond
    check("a dial move sets the Game and Chat balance", cm.handle([0x07, 0x45, 100, 40]) == (100, 40)
          and got == [(GAME_OUT, 100), (CHAT_OUT, 40)])
    got.clear()
    check("the same position twice does nothing", cm.handle([0x07, 0x45, 100, 40]) is None and got == [])
    check("other messages are ignored", cm.handle([0x07, 0x12, 1, 2]) is None and got == [])
    check("out-of-range numbers are held to 0..100", cm.handle([0x07, 0x45, 250, 0]) == (100, 0))
    return 0 if ok else 1


def main():
    if "--self-test" in sys.argv:
        return self_test()
    import hid   # python3-hidapi
    path = find_path(hid)
    if not path:
        log("base station not found (Arctis Nova Pro Wireless, 1038:12E0); nothing to do")
        return 0
    # The mixer's channels come up with PipeWire at login; wait for them (up to a minute).
    for _ in range(60):
        if {GAME_OUT, CHAT_OUT} <= set(node_ids()):
            break
        time.sleep(1)
    else:
        log("the TaylorOS mixer channels are missing; is PipeWire running?")
        return 1
    dev = hid.device()
    dev.open_path(path)
    cm = ChatMix(dev)

    def stop(*_):
        cm.stop = True
    signal.signal(signal.SIGTERM, stop)
    signal.signal(signal.SIGINT, stop)
    try:
        cm.start()
        log("ChatMix on: press the volume dial to switch it to ChatMix")
        cm.run()
    except OSError:
        log("base station unplugged")
    finally:
        cm.close()
        try:
            dev.close()
        except Exception:
            pass
    return 0


if __name__ == "__main__":
    sys.exit(main())
