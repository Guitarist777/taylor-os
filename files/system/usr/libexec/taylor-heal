#!/usr/bin/bash
# TAYLOR OS start-up repair (2026-11-18). Runs as root on every boot, before the login screen, and changes only what is wrong:
#  1. A safety net: if the PC is set to start in text mode, start it in picture mode (the login screen). Her first boot
#     (2026-11-18) came up in text mode because the image had lost its login screen (removing Terra's Xwayland took it
#     along; fixed in the recipe). A text-mode default left by any install, or by hand, is put right here too.
#  2. Hyprland 0.57 reads only ~/.config/hypr/hyprland.lua and, when there is none, writes its own example there. Accounts
#     made before TAYLOR OS shipped a .lua got that example instead of her desktop. Replace ONLY that exact example (or a
#     missing file) with /etc/skel's copy; any other hyprland.lua is hers and is never touched. The old file is kept.
set -u
log() { echo "taylor-heal: $*"; }

# 1. Start in picture mode
if [ "$(systemctl get-default)" != "graphical.target" ]; then
    log "default was $(systemctl get-default); setting graphical.target"
    systemctl set-default graphical.target
    systemctl start --no-block graphical.target
fi

# (Which desktop the login screen starts is not done here: /usr/lib/plasmalogin/plasmalogin.conf.d/10-taylor.conf sets
#  it. Writing the old /var/lib/plasmalogin/state.conf did nothing; the 2026-11-18 virtual PC test still logged in to KDE.)

# 2. Her desktop settings
skel=/etc/skel/.config/hypr/hyprland.lua
stamp=$(date +%Y%m%d-%H%M%S)
[ -f "$skel" ] && getent passwd | while IFS=: read -r name _ uid gid _ home _; do
    [ "$uid" -ge 1000 ] && [ "$uid" -lt 60000 ] || continue
    [ -d "$home" ] || continue
    dir="$home/.config/hypr"
    target="$dir/hyprland.lua"
    if [ -f "$target" ]; then
        grep -q "TAYLOR-OS-DESKTOP" "$target" && continue                                # already hers from TAYLOR OS
        grep -q "This is an example Hyprland Lua config file" "$target" || continue    # her own file: leave it alone
        mv -f "$target" "$target.example-$stamp"
        log "$name: Hyprland's example settings kept as hyprland.lua.example-$stamp"
    fi
    install -d -o "$uid" -g "$gid" "$home/.config" "$dir"
    install -m 0644 -o "$uid" -g "$gid" "$skel" "$target"
    log "$name: TAYLOR desktop settings put in place"
done

# 2a. Windows key + Space opens her launcher (2026-11-19, her design) instead of fuzzel. Her settings file is hers, so
#     only TAYLOR's own line, exactly as TAYLOR OS wrote it, is changed; a copy of the file is kept first.
old_space='hl.bind(mod .. " + Space",  hl.dsp.exec_cmd("fuzzel"))'
new_space='hl.bind(mod .. " + Space",  hl.dsp.exec_cmd("quickshell ipc call launcher toggle"))   -- her launcher (TAYLOR'"'"'s dial)'
getent passwd | while IFS=: read -r name _ uid gid _ home _; do
    [ "$uid" -ge 1000 ] && [ "$uid" -lt 60000 ] || continue
    target="$home/.config/hypr/hyprland.lua"
    [ -f "$target" ] && grep -q "TAYLOR-OS-DESKTOP" "$target" && grep -qxF "$old_space" "$target" || continue
    cp -p "$target" "$target.before-launcher-$stamp"
    tmp=$(mktemp) && awk -v o="$old_space" -v n="$new_space" '$0 == o { print n; next } { print }' "$target" > "$tmp" \
        && cat "$tmp" > "$target" && rm -f "$tmp" && log "$name: Windows key + Space now opens her launcher (old file kept)"
done

# 2c. Her lock screen (2026-11-21, her build brief phase 6): Windows key + L opens her lock screen (the dial) instead of
#     hyprlock, the power key plays her goodnight, hypridle only locks before sleep (her timeout is the desktop's own),
#     and Hyprland lets the backup lock screen take over if hers ever dies. Only TAYLOR's own lines, exactly as TAYLOR OS
#     wrote them, are changed, once (a file that already says taylor-lock is left alone); a copy is kept first.
old_l='hl.bind(mod .. " + L",      hl.dsp.exec_cmd("hyprlock"))'
new_l='hl.bind(mod .. " + L",      hl.dsp.exec_cmd("/usr/libexec/taylor-lock now"))   -- her lock screen (the dial)'
new_p='hl.bind("XF86PowerOff",     hl.dsp.exec_cmd("quickshell ipc call power shutdown"), { locked = true })   -- her goodnight, then off'
old_i='    hl.exec_cmd("hypridle")'
new_i='    hl.exec_cmd("hypridle -c /usr/share/taylor-os/hypridle.conf")   -- only locks before sleep; her timeout is the desktop'"'"'s own'
old_m='        background_color         = "rgb(0f1010)",'
new_m='        allow_session_lock_restore = true,   -- if her lock screen ever dies, the backup lock screen can take over (taylor-lock)'
getent passwd | while IFS=: read -r name _ uid gid _ home _; do
    [ "$uid" -ge 1000 ] && [ "$uid" -lt 60000 ] || continue
    target="$home/.config/hypr/hyprland.lua"
    [ -f "$target" ] && grep -q "TAYLOR-OS-DESKTOP" "$target" && ! grep -q "taylor-lock" "$target" && grep -qxF "$old_l" "$target" || continue
    cp -p "$target" "$target.before-lock-$stamp"
    tmp=$(mktemp) && awk -v ol="$old_l" -v nl="$new_l" -v np="$new_p" -v oi="$old_i" -v ni="$new_i" -v om="$old_m" -v nm="$new_m" '
        $0 == ol { print nl; print np; next }
        $0 == oi { print ni; next }
        $0 == om { print; print nm; next }
        { print }' "$target" > "$tmp" \
        && cat "$tmp" > "$target" && rm -f "$tmp" && log "$name: Windows key + L now opens her lock screen (old file kept)"
done

# 2b. The desktop itself (Quickshell: dock, window bar, clock, mixer, sky). It lives in the system
#     (/usr/share/taylor-os/quickshell) so every update brings the new version. Each account's ~/.config/quickshell
#     points there. A copy TAYLOR OS made earlier (its shell.qml says "TAYLOR OS desktop") is kept beside the pointer;
#     a folder of her own is never touched.
shell=/usr/share/taylor-os/quickshell
if [ -f "$shell/shell.qml" ]; then
    getent passwd | while IFS=: read -r name _ uid gid _ home _; do
        [ "$uid" -ge 1000 ] && [ "$uid" -lt 60000 ] || continue
        [ -d "$home" ] || continue
        q="$home/.config/quickshell"
        [ -L "$q" ] && continue                                                # already a pointer: leave it
        if [ -d "$q" ]; then
            grep -q "TAYLOR OS desktop" "$q/shell.qml" 2>/dev/null || continue   # her own desktop files: leave them
            mv -f "$q" "$q.taylor-old-$stamp"
            log "$name: the old copy of the TAYLOR desktop kept as quickshell.taylor-old-$stamp"
        elif [ -e "$q" ]; then
            continue                                                           # something else of hers: leave it
        fi
        install -d -o "$uid" -g "$gid" "$home/.config"
        ln -s "$shell" "$q"
        chown -h "$uid:$gid" "$q"
        log "$name: the TAYLOR desktop now comes from the system (updates reach it)"
    done
fi

# 3. Bazzite's welcome window ("Bazzite Portal") opens at every login until it is switched off, on top of her TAYLOR desktop
#    (2026-11-18 virtual PC test). Keep it to KDE: add NotShowIn=Hyprland to Bazzite's own start-up file in each account.
#    Only Bazzite's file is touched (it runs yafti_gtk.py), and only once (a file that already says NotShowIn is left alone).
getent passwd | while IFS=: read -r name _ uid gid _ home _; do
    [ "$uid" -ge 1000 ] && [ "$uid" -lt 60000 ] || continue
    f="$home/.config/autostart/bazzite-portal.desktop"
    [ -f "$f" ] || continue
    grep -q '^Exec=yafti_gtk.py' "$f" || continue
    grep -q '^NotShowIn=' "$f" && continue
    [ -n "$(tail -c1 "$f")" ] && echo >> "$f"     # the file's last line must end before ours starts
    printf 'NotShowIn=Hyprland;\n' >> "$f"
    log "$name: Bazzite's welcome window kept to KDE"
done
exit 0
