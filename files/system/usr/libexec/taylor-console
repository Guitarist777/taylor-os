#!/bin/sh
# Between the boot screen and her login screen the PC shows its text screen (tty1) for a moment, whose black is pure
# #000000 and whose cursor blinks. This makes that moment her dark instead (2026-11-21): the text screen's black is
# #0B0D0C (the colour of the boot screen and of her opening; set by the kernel options in
# /usr/lib/bootc/kargs.d/10-taylor-boot.toml, and again here in case a PC started without them), and tty1's cursor is
# hidden and the screen cleared. Only the palette's black changes; every other colour stays the kernel's own, so the
# text sign-in (her safety net) and any message still read exactly as before.
out=$(setvtrgb /usr/share/taylor-os/console/vtrgb 2>&1); rc=$?
echo "taylor-console: setvtrgb exit $rc ${out:+($out)}; black is now $(cut -d, -f1 /sys/module/vt/parameters/default_red),$(cut -d, -f1 /sys/module/vt/parameters/default_grn),$(cut -d, -f1 /sys/module/vt/parameters/default_blu)"
[ -w /dev/tty1 ] && printf '\033[?25l\033[2J\033[H' > /dev/tty1 2>/dev/null
exit 0
