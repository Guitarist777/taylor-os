#!/bin/sh
# TAYLOR OS login screen, started by greetd (as the greeter account) on every boot and after every sign-out.
# It runs a bare Hyprland that shows her login scene (her opening, then the night sky and TAYLOR's dial).
#
# The safety net: if her login screen fails twice in a row without anyone signing in (a broken update, a graphics
# problem), the plain text sign-in (tuigreet) takes over, so she is never locked out. It still starts her TAYLOR
# desktop, and F3 there can pick KDE Plasma instead. The count lives in /tmp, so a restart tries her screen again.

# Her TAYLOR desktop (her ruling 2026-11-20): a start that ends within 40 s of her sign-in counts as a failed start;
# after 5 in a row her login screen picks the KDE backup itself and says why. A desktop that runs longer resets it.
# The login screen writes /tmp/taylor-desktop-start ("taylor" or "kde", and the time) just before it starts one.
start=/tmp/taylor-desktop-start
dfails=/tmp/taylor-desktop-fails
if [ -r "$start" ]; then
    read -r kind at < "$start"
    d=$(cat "$dfails" 2>/dev/null || echo 0)
    case "$d" in ''|*[!0-9]*) d=0 ;; esac
    case "$at" in ''|*[!0-9]*) at=0 ;; esac
    ran=$(( $(date +%s) - at ))
    if [ "$kind" = taylor ]; then
        if [ "$ran" -lt 40 ]; then d=$((d + 1)); else d=0; fi
        echo "$d" > "$dfails"
        logger -t taylor-greeter -- "her TAYLOR desktop ran $ran s; failed starts in a row: $d" 2>/dev/null   # journal, not the screen
    fi
    rm -f "$start"
fi

fails="/tmp/taylor-greeter-fails-$(id -u)"
n=$(cat "$fails" 2>/dev/null || echo 0)
case "$n" in ''|*[!0-9]*) n=0 ;; esac

if [ "$n" -ge 2 ]; then
    logger -t taylor-greeter -- "her login screen failed $n times; using the text sign-in" 2>/dev/null
    # The boot screen leaves its picture up (plymouth quit --retain-splash), which keeps this console in picture
    # mode: put it back in text mode (KDSETMODE, KD_TEXT) so the text sign-in can be seen.
    python3 -c 'import fcntl; fcntl.ioctl(0, 0x4B3A, 0)' 2>/dev/null || true
    [ -t 1 ] && printf '\033[2J\033[H\033[?25h'
    exec tuigreet --time --remember --asterisks \
        --greeting "TAYLOR OS" \
        --cmd "uwsm start -e -D Hyprland hyprland.desktop"
fi

echo $((n + 1)) > "$fails"
rm -f /tmp/taylor-greeter-ok
echo "$(cut -d' ' -f1 /proc/uptime) login screen starting" >> /tmp/taylor-greeter-times.log
# The text screen stays dark until her opening draws (2026-11-21): no cursor, nothing written on it. Hyprland's own
# start-up lines go to a file instead of the screen (they are in its log under /run/user too).
[ -t 1 ] && printf '\033[?25l\033[2J\033[H'
hlog=/tmp/taylor-greeter-hyprland.log
# start-hyprland is Hyprland's own launcher; started bare, Hyprland paints a red warning bar over her opening.
if command -v start-hyprland >/dev/null 2>&1; then
    start-hyprland -- -c /usr/share/taylor-os/greeter/hyprland.lua > "$hlog" 2>&1
else
    Hyprland -c /usr/share/taylor-os/greeter/hyprland.lua > "$hlog" 2>&1
fi
# The scene writes this file only when greetd accepted her password and her desktop is about to start.
if [ -e /tmp/taylor-greeter-ok ]; then
    echo 0 > "$fails"
fi
