#!/bin/sh
# Her two Settings choices for the login screen (2026-11-21): "Boot animation: play the full opening" and "Reduce motion".
# The login screen runs as the greeter account and cannot read her home, so this (run by root, at start-up before the
# login screen and again whenever her settings file changes) copies JUST those two to /var/lib/taylor-os/greeter.json.
#
# Safe by design:
#  - her files are read as HER (setpriv to her account), never as root, and at most 64 KB of it;
#  - only two true/false values are ever written ({"bootAnimation": .., "reduceMotion": ..}); anything else in her file,
#    or a broken file, gives the defaults (the full opening, with motion);
#  - the file is written next to itself and moved into place, so the login screen never sees half a file;
#  - the login screen checks it again and takes the defaults if it is anything but those two values.
# "Reduce motion" is on when her own switch is on OR her system's no-animations setting is (GNOME's enable-animations,
# which her desktop follows too, quickshell/Theme.qml).
set -u
out_dir=/var/lib/taylor-os
out="$out_dir/greeter.json"

# whose PC it is: the same first person account the login screen signs in
line=$(getent passwd | awk -F: '$3 >= 1000 && $3 < 60000 && $7 !~ /nologin|false/ {print $1 ":" $3 ":" $4 ":" $6; exit}')
user=${line%%:*}; rest=${line#*:}; uid=${rest%%:*}; rest=${rest#*:}; gid=${rest%%:*}; home=${rest#*:}

settings=""
still_sys=false
if [ -n "$user" ] && [ -n "$home" ]; then
    as_her() { timeout 10 setpriv --reuid="$uid" --regid="$gid" --init-groups -- env -i HOME="$home" USER="$user" PATH=/usr/bin:/bin "$@"; }
    settings=$(as_her head -c 65536 "$home/.config/taylor-os/settings.json" 2>/dev/null) || settings=""
    anim=$(as_her env XDG_RUNTIME_DIR="/run/user/$uid" DBUS_SESSION_BUS_ADDRESS=disabled: gsettings get org.gnome.desktop.interface enable-animations 2>/dev/null) || anim=""
    [ "$anim" = false ] && still_sys=true
fi

mkdir -p "$out_dir" && chmod 0755 "$out_dir"
tmp=$(mktemp "$out_dir/.greeter.json.XXXXXX") || exit 0
printf '%s' "$settings" | STILL_SYS="$still_sys" python3 -I -c '
import json, os, sys
full, still = True, False
try:
    j = json.loads(sys.stdin.read() or "null")
    if isinstance(j, dict):
        if isinstance(j.get("bootAnimation"), bool): full = j["bootAnimation"]
        if isinstance(j.get("reduceMotion"), bool): still = j["reduceMotion"]
except Exception:
    pass
if os.environ.get("STILL_SYS") == "true": still = True
print(json.dumps({"bootAnimation": full, "reduceMotion": still}))
' > "$tmp" 2>/dev/null || printf '{"bootAnimation": true, "reduceMotion": false}\n' > "$tmp"
chmod 0644 "$tmp"
mv -f "$tmp" "$out"
echo "taylor-greeter-prefs: for ${user:-nobody}: $(cat "$out")"

# Watch her settings from now on: her home is only known here, so the watcher is started for it (a no-op when it runs).
if [ -n "$home" ] && [ -d "$home" ]; then
    systemctl start --no-block "taylor-greeter-prefs@$(systemd-escape --path "$home").path" 2>/dev/null || true
fi
exit 0
