#!/bin/sh
# The KDE backup sign-in (her build brief: KDE always works as a backup login), started by her login screen when she
# pressed F2 before typing her password. It runs KDE Plasma exactly as Plasma's own session file says, so an update
# that changes how Plasma starts is followed; startplasma-wayland is the fallback.
f=/usr/share/wayland-sessions/plasma.desktop
cmd=$(sed -n 's/^Exec=//p' "$f" 2>/dev/null | head -1)
echo "taylor-kde-session: starting KDE Plasma" >&2
if [ -n "$cmd" ]; then
    exec sh -c "exec $cmd"
fi
exec /usr/bin/startplasma-wayland
